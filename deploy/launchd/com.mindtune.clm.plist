<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.mindtune.clm</string>
    <key>WorkingDirectory</key>
    <string>/Users/mindtune/MindTune-Lab</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>CLM09_DEPLOYMENT_MODE</key>
        <string>research_local</string>
    </dict>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/mindtune/MindTune-Lab/.venv/bin/uvicorn</string>
        <string>mindtune_clm.api.app:create_app</string>
        <string>--host</string>
        <string>127.0.0.1</string>
        <string>--port</string>
        <string>8005</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>StandardOutPath</key>
    <string>/Users/mindtune/Library/Logs/mindtune-clm.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/mindtune/Library/Logs/mindtune-clm.error.log</string>
</dict>
</plist>
