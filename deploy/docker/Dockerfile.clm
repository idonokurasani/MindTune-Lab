# Multi-stage CLM-09 container
FROM python:3.11-slim AS base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONPATH=/app/packages/clm/src:/app/packages/mpe/src

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends gcc libc6-dev \
    && rm -rf /var/lib/apt/lists/* \
    && useradd -m -u 1000 mindtune \
    && mkdir -p /data /tmp/ruff_cache /tmp/mypy_cache \
    && chown -R mindtune:mindtune /data /tmp/ruff_cache /tmp/mypy_cache

COPY pyproject.toml requirements.txt ./
COPY packages/mpe /app/packages/mpe
COPY packages/clm /app/packages/clm

RUN pip install --no-cache-dir -e ./packages/mpe -e ./packages/clm

COPY . /app

USER mindtune

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8005/api/v1/health/live')" || exit 1

EXPOSE 8005

CMD ["python", "-m", "uvicorn", "mindtune_clm.api.app:create_app", "--host", "127.0.0.1", "--port", "8005"]
